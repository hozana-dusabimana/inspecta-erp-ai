# ───────────────────────────────────────────────────────────────
# INSPECTA BUILDOS — Backend environment
# Copy to ".env" and adjust. `npm start` uses LOCAL Postgres below;
# `docker compose up` overrides DATABASE_URL to the bundled db service.
# ───────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=4000

# Frontend origin allowed by CORS (Vite dev server)
CORS_ORIGIN=http://localhost:3000

# Public web app base URL — used to build links in emails (e.g. the signup
# email-verification link). Defaults to the first CORS_ORIGIN when unset.
APP_URL=http://localhost:3000

# ── Database (LOCAL Postgres for `npm start`) ──────────────────
# Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME?schema=public
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/inspecta_buildos?schema=public

# ── Auth ───────────────────────────────────────────────────────
JWT_ACCESS_SECRET=change-me-access-secret-please-rotate-in-prod
JWT_REFRESH_SECRET=change-me-refresh-secret-please-rotate-in-prod
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# ── AI provider abstraction ────────────────────────────────────
# Default provider when none specified. One of: openrouter | claude | gemini
AI_PROVIDER=openrouter

# OpenRouter (default, free models). Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Anthropic Claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ── Document / file storage (Cloudinary) ──────────────────────
# REQUIRED for file uploads. Cloudinary stores the bytes; our database stores
# the returned link. The browser uploads directly to Cloudinary using a
# short-lived signature minted here, so files never pass through this server
# and the API secret never reaches the browser.
# Get these from https://console.cloudinary.com/app/settings/api-keys
# Until they are set, "Upload file" returns a clear error — attaching a link
# works with no configuration at all.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Everything is uploaded under this prefix, so one Cloudinary account can be
# shared with other apps without the media libraries colliding.
CLOUDINARY_FOLDER=inspecta

# ── Email / SMTP (Module 9 email channel + signup verification) ─
# Powers email notifications AND the signup email-verification link. Company
# mailbox is Private Email (privateemail.com): host=mail.privateemail.com,
# port=465 (SSL) or 587 (STARTTLS), user=info@inspecta.africa, pass=<mailbox password>.
# Set SMTP_PASS via a secret — never commit it. Leave blank to disable email —
# signup then logs the verify link to the server console (in-app notifications still work).
SMTP_HOST=mail.privateemail.com
SMTP_PORT=465
SMTP_USER=info@inspecta.africa
SMTP_PASS=
EMAIL_FROM=Inspecta <info@inspecta.africa>
# Monitored inbox that also receives org-wide alerts + demo/contact enquiries.
NOTIFY_FALLBACK_EMAIL=info@inspecta.africa

# Seed admin — ensured by `npm run seed` AND on every API boot.
# The password is written while the account has never been signed into; once it
# has, it belongs to the user and the seed stops touching it.
SEED_ADMIN_EMAIL=admin@inspecta.africa
SEED_ADMIN_PASSWORD=Admin@123
# Break-glass for a lockout: set to true for ONE boot to force the password
# above back onto the account, then unset it again.
SEED_ADMIN_RESET_PASSWORD=
